msgid "“System default” uses the language of your desktop."
msgstr "«Systemstandard» bruker språket på skrivebordet ditt."

#: src/ui.rs:482
msgid "Uninstall Stress"
msgstr "Avinstaller Stress"

#: src/ui.rs:483
msgid ""
"Removes the program, its menu entry and the helpers it installed, and "
"optionally the settings."
msgstr "Fjerner programmet, menyoppføringen og hjelpeprogrammene det installerte, og eventuelt innstillingene."

#: src/ui.rs:486 src/ui.rs:622
msgid "Uninstall"
msgstr "Avinstaller"

#: src/ui.rs:532
msgid "Safety"
msgstr "Sikkerhet"

#: src/ui.rs:537
msgid "Temperature Limits"
msgstr "Temperaturgrenser"

#: src/ui.rs:538
msgid "A test stops by itself when a limit is reached."
msgstr "En test stopper av seg selv når en grense nås."

#: src/ui.rs:548
msgid "Processor"
msgstr "Prosessor"

#: src/ui.rs:548 src/ui.rs:549
msgid "°C"
msgstr "°C"

#: src/ui.rs:549
msgid "Graphics card"
msgstr "Skjermkort"

#: src/ui.rs:554
msgid "Tests"
msgstr "Tester"

#: src/ui.rs:556
msgid "Longest test"
msgstr "Lengste test"

#: src/ui.rs:557
msgid "Minutes. Also applies to tests started without a duration."
msgstr "Minutter. Gjelder også tester som startes uten varighet."

#: src/ui.rs:562
msgid "Stop when running on battery"
msgstr "Stopp ved batteridrift"

#: src/ui.rs:617
msgid "Uninstall Stress?"
msgstr "Avinstallere Stress?"

#: src/ui.rs:618
msgid ""
"The program, its entry in the app menu and the helpers it installed will be "
"removed."
msgstr "Programmet, oppføringen i programmenyen og hjelpeprogrammene det installerte blir fjernet."

#: src/ui.rs:620
msgid "Also delete the settings"
msgstr "Slett også innstillingene"

#: src/ui.rs:622
msgid "Cancel"
msgstr "Avbryt"

#: src/ui.rs:641
msgid "Uninstalling failed: {}"
msgstr "Avinstalleringen mislyktes: {}"

#: src/ui.rs:645
msgid ""
"Stress and all its settings have been removed. The window will now close."
msgstr "Stress og alle innstillingene er fjernet. Vinduet lukkes nå."

#: src/ui.rs:647
msgid "Stress has been removed. The window will now close."
msgstr "Stress er fjernet. Vinduet lukkes nå."

#: src/ui.rs:649
msgid "Uninstalled"
msgstr "Avinstallert"

#: src/ui.rs:650
msgid "Close"
msgstr "Lukk"

