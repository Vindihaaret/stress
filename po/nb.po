msgid "Temperature"
msgstr "Temperatur"

#: src/ui.rs:220 src/ui.rs:243
msgid "Utilization"
msgstr "Utnyttelse"

#: src/ui.rs:222 src/ui.rs:245
msgid "Power"
msgstr "Effekt"

#: src/ui.rs:227
msgid ""
"CPU power is not available: on this system only the administrator can read "
"it."
msgstr "Prosessorens effekt er ikke tilgjengelig: på dette systemet kan bare administratoren lese den."

#: src/ui.rs:248 src/ui.rs:284
msgid "Fan"
msgstr "Vifte"

#: src/ui.rs:254
msgid "Graphics Cards"
msgstr "Skjermkort"

#: src/ui.rs:254
msgid "Other Graphics Cards"
msgstr "Andre skjermkort"

#: src/ui.rs:261
msgid "No graphics card found"
msgstr "Fant ikke noe skjermkort"

#: src/ui.rs:268
msgid "The power supply updates its readings every few seconds."
msgstr "Strømforsyningen oppdaterer målingene sine med noen sekunders mellomrom."

#: src/ui.rs:269
msgid "Output to the computer"
msgstr "Levert til maskinen"

#: src/ui.rs:271
msgid "From the wall"
msgstr "Fra stikkontakten"

#: src/ui.rs:272
msgid ""
"Calculated from the efficiency class; the power supply does not measure it."
msgstr "Beregnet ut fra virkningsgradklassen; strømforsyningen måler det ikke selv."

#: src/ui.rs:276
msgid "Rest of the computer"
msgstr "Resten av maskinen"

#: src/ui.rs:277
msgid ""
"Motherboard, memory, disks and fans: the power supply's output minus the "
"processor and graphics cards."
msgstr "Hovedkort, minne, disker og vifter: det strømforsyningen leverer, minus prosessor og skjermkort."

#: src/ui.rs:281
msgid "Details"
msgstr "Detaljer"

#: src/ui.rs:282
msgid "Input voltage"
msgstr "Inngangsspenning"

#: src/ui.rs:292
msgid "{} rail"
msgstr "{}-skinne"

#: src/ui.rs:425
msgid ""
"Put the processor and graphics card under controlled load and watch "
"temperatures, fans and power use."
msgstr "Sett prosessor og skjermkort under kontrollert last og følg temperaturer, vifter og strømforbruk."

